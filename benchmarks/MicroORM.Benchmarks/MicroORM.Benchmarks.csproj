<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Benchmark classes must be public and non-sealed; their methods are called by BenchmarkDotNet. -->
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1001;CA2007;CA1849;CA1707;CA1852</NoWarn>
    <!-- Not a library: public members need no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MicroORM\MicroORM.csproj" />
  </ItemGroup>

</Project>
